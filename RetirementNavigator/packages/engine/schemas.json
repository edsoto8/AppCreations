 "Contribution401kInputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "age": {
    "type": "integer",
    "minimum": 0,
    "maximum": 120
   },
   "retirementAge": {
    "type": "integer",
    "minimum": 0,
    "maximum": 120
   },
   "salary": {
    "type": "integer",
    "minimum": 0,
    "maximum": 9007199254740991
   },
   "salaryGrowth": {
    "default": 0,
    "type": "number",
    "minimum": -1,
    "maximum": 1
   },
   "planType": {
    "default": "401k",
    "type": "string",
    "enum": [
     "401k",
     "403b",
     "457b"
    ]
   },
   "planOffersRoth": {
    "default": true,
    "type": "boolean"
   },
   "traditionalPctOfSalary": {
    "default": 0,
    "type": "number",
    "minimum": 0,
    "maximum": 1
   },
   "rothPctOfSalary": {
    "default": 0,
    "type": "number",
    "minimum": 0,
    "maximum": 1
   },
   "match": {
    "default": null,
    "anyOf": [
     {
      "type": "object",
      "properties": {
       "tiers": {
        "maxItems": 5,
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "matchRate": {
           "type": "number",
           "minimum": 0,
           "maximum": 5
          },
          "bandPctOfPay": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          }
         },
         "required": [
          "matchRate",
          "bandPctOfPay"
         ]
        }
       },
       "flatPctOfPay": {
        "default": 0,
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "annualMatchCap": {
        "default": null,
        "anyOf": [
         {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
         },
         {
          "type": "null"
         }
        ]
       },
       "vesting": {
        "default": {
         "kind": "immediate"
        },
        "oneOf": [
         {
          "type": "object",
          "properties": {
           "kind": {
            "type": "string",
            "const": "immediate"
           }
          },
          "required": [
           "kind"
          ]
         },
         {
          "type": "object",
          "properties": {
           "kind": {
            "type": "string",
            "const": "cliff"
           },
           "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
           }
          },
          "required": [
           "kind",
           "years"
          ]
         },
         {
          "type": "object",
          "properties": {
           "kind": {
            "type": "string",
            "const": "graded"
           },
           "vestedByYear": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
             "type": "number",
             "minimum": 0,
             "maximum": 1
            }
           }
          },
          "required": [
           "kind",
           "vestedByYear"
          ]
         }
        ]
       },
       "yearsOfServiceAtStart": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 60
       }
      },
      "required": [
       "tiers"
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "traditionalBalance": {
    "default": 0,
    "type": "integer",
    "minimum": 0,
    "maximum": 9007199254740991
   },
   "rothBalance": {
    "default": 0,
    "type": "integer",
    "minimum": 0,
    "maximum": 9007199254740991
   },
   "annualReturn": {
    "type": "number",
    "minimum": -1,
    "maximum": 1
   },
   "inflation": {
    "default": 0,
    "type": "number",
    "exclusiveMinimum": -0.5,
    "maximum": 0.5
   },
   "priorYearFicaWages": {
    "default": null,
    "anyOf": [
     {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "age",
   "retirementAge",
   "salary",
   "annualReturn"
  ]
 },
