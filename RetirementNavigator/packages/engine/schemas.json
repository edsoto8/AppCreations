 "SocialSecurityInputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
   "source": {
    "oneOf": [
     {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "const": "none"
       }
      },
      "required": [
       "kind"
      ]
     },
     {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "const": "statement"
       },
       "piaMonthly": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       }
      },
      "required": [
       "kind",
       "piaMonthly"
      ]
     },
     {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "const": "atClaimAge"
       },
       "monthlyAtClaim": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       }
      },
      "required": [
       "kind",
       "monthlyAtClaim"
      ]
     },
     {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "const": "estimateAverage"
       },
       "averageAnnualEarnings": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
       },
       "yearsOfEarnings": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50
       }
      },
      "required": [
       "kind",
       "averageAnnualEarnings",
       "yearsOfEarnings"
      ]
     },
     {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "const": "estimateHistory"
       },
       "earnings": {
        "maxItems": 80,
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "year": {
           "type": "integer",
           "minimum": 1900,
           "maximum": 2200
          },
          "earnings": {
           "type": "integer",
           "minimum": 0,
           "maximum": 9007199254740991
          }
         },
         "required": [
          "year",
          "earnings"
         ]
        }
       }
      },
      "required": [
       "kind",
       "earnings"
      ]
     }
    ]
   },
   "claimAge": {
    "type": "object",
    "properties": {
     "years": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
     },
     "months": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
     }
    },
    "required": [
     "years",
     "months"
    ]
   }
  },
  "required": [
   "source",
   "claimAge"
  ]
 },
