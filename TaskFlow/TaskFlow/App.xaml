<Application x:Class="TaskFlow.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI (Fluent) resources first, so our styles can build on them -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- TaskFlow's own colours and styles -->
        <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
