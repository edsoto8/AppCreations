<Page x:Class="TaskFlow.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:TaskFlow"
      xmlns:controls="using:TaskFlow.Controls"
      xmlns:vm="using:TaskFlow.Core.ViewModels"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid x:Name="Root" Padding="16,16,16,0">

    <!--
      Responsive layout. The XAML below describes the NARROW layout (phones, small windows).
      When the window is at least 720px wide, the "Wide" state's setters adjust it.
    -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="720" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="Root.Padding" Value="32,28,32,0" />
            <Setter Target="SortBox.(Grid.Row)" Value="0" />
            <Setter Target="SortBox.(Grid.Column)" Value="1" />
            <Setter Target="SortBox.HorizontalAlignment" Value="Right" />
            <Setter Target="AddTaskLabel.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Everything sits in one centred column so long lines stay readable on wide screens -->
    <Grid MaxWidth="{StaticResource ContentMaxWidth}" RowSpacing="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Row 0: header -->
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock Text="TaskFlow" Style="{StaticResource PageTitleTextStyle}" />
          <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
          <ProgressBar Maximum="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                       Value="{x:Bind ViewModel.CompletedCount, Mode=OneWay}"
                       Width="160" HorizontalAlignment="Left" Margin="0,4,0,0"
                       AutomationProperties.Name="Completed tasks" />
        </StackPanel>

        <!-- Theme switching is purely visual, so it is handled in code-behind with a Click event -->
        <Button x:Name="ThemeButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                VerticalAlignment="Top" Click="ThemeButton_Click">
          <FontIcon x:Name="ThemeIcon" FontSize="16" Glyph="&#xE793;" />
        </Button>

        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Top"
                Command="{x:Bind ViewModel.AddTaskCommand}"
                AutomationProperties.Name="Add task" ToolTipService.ToolTip="Add task (Ctrl+N)">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" />
          </Button.KeyboardAccelerators>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon FontSize="14" Glyph="&#xE710;" />
            <TextBlock x:Name="AddTaskLabel" Text="Add task" Visibility="Collapsed" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Row 1: messages (collapsed when there is nothing to say, so it takes no space) -->
      <StackPanel Grid.Row="1" Spacing="8"
                  Visibility="{x:Bind local:Ui.VisibleIfAny(ViewModel.HasError, ViewModel.HasWarning), Mode=OneWay}">
        <InfoBar Severity="Error" Title="Something went wrong"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 CloseButtonCommand="{x:Bind ViewModel.DismissErrorCommand}" />
        <InfoBar Severity="Warning"
                 IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                 Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                 CloseButtonCommand="{x:Bind ViewModel.DismissWarningCommand}" />
      </StackPanel>

      <!-- Row 2: filter and sort. Narrow: stacked. Wide: side by side (see the Wide state). -->
      <Grid Grid.Row="2" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <RadioButtons MaxColumns="3" HorizontalAlignment="Left" AutomationProperties.Name="Show"
                      ItemsSource="{x:Bind ViewModel.FilterChoices}"
                      SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" />
        <ComboBox x:Name="SortBox" Grid.Row="1" MinWidth="160" PlaceholderText="Sort by"
                  AutomationProperties.Name="Sort by"
                  ItemsSource="{x:Bind ViewModel.SortChoices}"
                  SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
      </Grid>

      <!-- Row 3: the list, the empty state and the loading indicator share the same cell -->
      <Grid Grid.Row="3">
        <ListView ItemsSource="{x:Bind ViewModel.Tasks}" SelectionMode="None"
                  Padding="0,0,0,24" AutomationProperties.Name="Tasks">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,8" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskItemViewModel">
              <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox MinWidth="0" VerticalAlignment="Top" Margin="0,-4,0,0"
                            IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                            Command="{x:Bind ToggleCompletedCommand}"
                            AutomationProperties.Name="{x:Bind local:Ui.Label('Complete', Title), Mode=OneWay}" />

                  <StackPanel Grid.Column="1" Spacing="4"
                              Opacity="{x:Bind local:Ui.DimIf(IsCompleted), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CardTitleTextStyle}"
                               TextDecorations="{x:Bind local:Ui.StrikeIf(IsCompleted), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                               MaxLines="2" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind HasDescription, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                      <controls:PriorityBadge Priority="{x:Bind Priority, Mode=OneWay}" />
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                  Visibility="{x:Bind ShowRegularDueDate, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE787;" Foreground="{ThemeResource MutedTextBrush}" />
                        <TextBlock Text="{x:Bind DueDateText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                  Visibility="{x:Bind IsOverdue, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{x:Bind OverdueText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind EditCommand}"
                            ToolTipService.ToolTip="Edit"
                            AutomationProperties.Name="{x:Bind local:Ui.Label('Edit', Title), Mode=OneWay}">
                      <FontIcon FontSize="14" Glyph="&#xE70F;" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind DeleteCommand}"
                            ToolTipService.ToolTip="Delete"
                            AutomationProperties.Name="{x:Bind local:Ui.Label('Delete', Title), Mode=OneWay}">
                      <FontIcon FontSize="14" Glyph="&#xE74D;" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
          <FontIcon Glyph="&#xE9D5;" FontSize="40" Foreground="{ThemeResource MutedTextBrush}" />
          <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                     HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>

        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" />
      </Grid>
    </Grid>
  </Grid>
</Page>
