<Page x:Class="TaskFlow.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:TaskFlow.Core.ViewModels"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid Padding="24" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: title + counter on the left, Add Task on the right -->
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="TaskFlow" FontSize="32" FontWeight="SemiBold" />
        <!-- OneWay: update the text whenever the view model raises PropertyChanged for SummaryText -->
        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Opacity="0.7" />
      </StackPanel>
      <!-- Command instead of Click: the button calls MainViewModel.AddTaskCommand -->
      <Button Grid.Column="1" Content="Add Task" Command="{x:Bind ViewModel.AddTaskCommand}" VerticalAlignment="Center" />
    </Grid>

    <!-- Filter and sort. TwoWay: when the user picks an item, the view model property is updated. -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
      <ComboBox Header="Show" MinWidth="140"
                ItemsSource="{x:Bind ViewModel.FilterChoices}"
                SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" />
      <ComboBox Header="Sort by" MinWidth="140"
                ItemsSource="{x:Bind ViewModel.SortChoices}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" />
    </StackPanel>

    <InfoBar Grid.Row="1" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
             Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

    <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Tasks}" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:TaskItemViewModel">
          <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{x:Bind IsCompleted, Mode=OneWay}"
                      Command="{x:Bind ToggleCompletedCommand}"
                      MinWidth="0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" />
              <TextBlock Text="{x:Bind Description, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
              <TextBlock Opacity="0.7" FontSize="12">
                <Run Text="{x:Bind PriorityLabel, Mode=OneWay}" />
                <Run Text="  " />
                <Run Text="{x:Bind DueDateText, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Edit" Command="{x:Bind EditCommand}" />
              <Button Content="Delete" Command="{x:Bind DeleteCommand}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
