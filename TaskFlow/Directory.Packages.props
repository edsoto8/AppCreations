<Project ToolsVersion="15.0">
  <!--
    Central package management: every PackageReference in the solution takes its version from here.

    Uno packages are NOT listed here. Their versions come from the Uno.Sdk version in global.json.
    See https://aka.platform.uno/using-uno-sdk for more information.

    CommunityToolkit.Mvvm and Microsoft.Extensions.Logging.Abstractions match the versions Uno.Sdk 7.0.5 uses,
    so the app and TaskFlow.Core agree.
  -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />

    <!-- Test-only packages -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
