<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MetroSim.App.ViewModels"
             xmlns:c="using:MetroSim.App.Controls"
             x:Class="MetroSim.App.Views.FinancePanel"
             x:DataType="vm:FinanceViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8" Margin="0,4,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Treasury" Classes="caption" />
          <TextBlock Name="BalanceLabel" Text="{Binding BalanceText}" FontSize="22" FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="Net per day" Classes="caption" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding NetText}" Foreground="{Binding NetBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <c:LineChart Height="180" Series="{Binding Chart}" Title="Daily income, expenses and balance (60 days)"
                   AxisFormat="{x:Static vm:FinanceViewModel.MoneyAxis}" SecondaryFormat="{x:Static vm:FinanceViewModel.MoneyAxis}" />

      <Border Background="#20000000" CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding LedgerTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
          <ItemsControl Name="LedgerRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LedgerRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <TextBlock Text="{Binding Label}" Classes="caption" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Separator Margin="0,4" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Text="Income / expenses" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding IncomeText}" Foreground="{x:Static vm:MainViewModel.PositiveBrush}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="{Binding ExpensesText}" Foreground="{x:Static vm:MainViewModel.NegativeBrush}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="3" Text="{Binding NetText}" Foreground="{Binding NetBrush}" FontWeight="SemiBold" />
          </Grid>
          <TextBlock Text="{Binding TodayText}" Classes="caption" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Text="Tax rates" Classes="heading" Margin="0,6,0,0" />
      <TextBlock Text="Higher taxes raise income but lower demand and satisfaction." Classes="caption" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="90,*,40" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Text="Residential" VerticalAlignment="Center" Foreground="{StaticResource ResidentialBrush}" />
        <Slider Name="ResidentialTaxSlider" Grid.Column="1" Minimum="{Binding MinTax}" Maximum="{Binding MaxTax}" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding ResidentialTax}" />
        <TextBlock Grid.Column="2" Text="{Binding ResidentialTax, StringFormat='{}{0}%'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Grid.Row="1" Text="Commercial" VerticalAlignment="Center" Foreground="{StaticResource CommercialBrush}" />
        <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding MinTax}" Maximum="{Binding MaxTax}" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding CommercialTax}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CommercialTax, StringFormat='{}{0}%'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Grid.Row="2" Text="Industrial" VerticalAlignment="Center" Foreground="{StaticResource IndustrialBrush}" />
        <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding MinTax}" Maximum="{Binding MaxTax}" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding IndustrialTax}" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding IndustrialTax, StringFormat='{}{0}%'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
