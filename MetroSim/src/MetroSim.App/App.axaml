<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MetroSim.App.App"
             Name="MetroSim"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#3FA7D6" RegionColor="#161B22" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MetroSim/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
