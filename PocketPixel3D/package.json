{
  "name": "pocket-pixel-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D retro handheld console with three playable original games (Three.js + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @screenshots --trace off"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
