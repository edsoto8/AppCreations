@using DotNet11Lab.Core.Labs.Libraries

<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Step</th><th>Observed</th></tr></thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr class="@(row.Observed.Contains("Exception", StringComparison.Ordinal) ? "row-danger" : "")">
                    <td class="mono small">@row.Step</td>
                    <td class="small">@row.Observed</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StreamObservation> Rows { get; set; } = [];
}
