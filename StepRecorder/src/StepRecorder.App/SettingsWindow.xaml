<Window x:Class="StepRecorder.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step Recorder Settings"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=FolderBox}">
    <StackPanel Margin="16">
        <Label Content="_Recordings folder" Target="{Binding ElementName=FolderBox}" Padding="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="_Browse…" Margin="8,0,0,0" Padding="12,2" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Padding="2" />
        </DockPanel>
        <TextBlock x:Name="FolderHint" Margin="0,4,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

        <Label Content="Default recording _name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" Padding="2" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="Used in each recording's folder name, after the date and time. Changes apply to the next recording." />

        <GroupBox Header="Reports written when a recording stops" Margin="0,16,0,0" Padding="8,6">
            <StackPanel>
                <CheckBox x:Name="HtmlBox" Content="_HTML report (report.html), opens in a browser" Margin="0,2" />
                <CheckBox x:Name="MarkdownBox" Content="_Markdown report (report.md), for wikis, tickets and pull requests" Margin="0,2" />
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Firebrick"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" IsDefault="True" MinWidth="80" Padding="12,2" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="12,2" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
