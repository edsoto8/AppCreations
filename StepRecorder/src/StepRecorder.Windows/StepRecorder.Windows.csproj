<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Lets the project build on macOS/Linux; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- For System.Windows.Automation (UIAutomationClient/UIAutomationTypes); no WPF UI lives here. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops this implicit using (it clashes with WPF's Shapes.Path, which this project doesn't use). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StepRecorder.Core\StepRecorder.Core.csproj" />
  </ItemGroup>

</Project>
