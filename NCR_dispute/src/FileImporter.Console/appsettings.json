{
  "Import": {
    "SourceDirectory": "C:\\Imports\\NcrDispute",
    "FilePattern": "*.csv",
    "ArchiveFolderName": "Archive",
    "Delimiter": ",",
    "Encoding": "utf-8",
    "MinFileAgeSeconds": 30,
    "ProcessingTimeoutMinutes": 60,
    "Columns": [
      { "SourceName": "DisputeId", "DestinationName": "DisputeId", "Required": true, "MaxLength": 50 },
      { "SourceName": "AccountNumber", "DestinationName": "AccountNumber", "Required": true, "MaxLength": 34 },
      { "SourceName": "TransactionDate", "DestinationName": "TransactionDate", "Required": true, "Type": "Date" },
      { "SourceName": "Amount", "DestinationName": "Amount", "Required": true, "Type": "Decimal" },
      { "SourceName": "CurrencyCode", "DestinationName": "CurrencyCode", "Required": true, "MaxLength": 3 },
      { "SourceName": "ReasonCode", "DestinationName": "ReasonCode", "Required": true, "MaxLength": 10 },
      { "SourceName": "Description", "DestinationName": "Description", "MaxLength": 500 }
    ]
  },

  "Database": {
    "ConnectionString": "",
    "StagingTable": "dbo.NcrDisputeStaging",
    "ImportIdColumn": "ImportId",
    "RowNumberColumn": "SourceRowNumber",
    "ValidationProcedure": "dbo.usp_ValidateNcrDisputeImport",
    "BulkCopyBatchSize": 5000,
    "BulkCopyTimeoutSeconds": 600,
    "CommandTimeoutSeconds": 120
  },

  "Smtp": {
    "Enabled": true,
    "Host": "smtp.example.com",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "From": "file-import@example.com",
    "To": [ "data-team@example.com" ],
    "SubjectPrefix": "[NCR Dispute Import]",
    "TimeoutSeconds": 30
  },

  "Retry": {
    "MaxAttempts": 3,
    "InitialDelaySeconds": 2
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/file-import-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
