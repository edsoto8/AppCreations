<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BoardFlow.App.ViewModels"
             xmlns:domain="using:BoardFlow.Core.Domain"
             xmlns:conv="using:BoardFlow.App.Converters"
             xmlns:infra="using:BoardFlow.App.Infrastructure"
             x:Class="BoardFlow.App.Views.CardEditorView"
             x:DataType="vm:CardEditorViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Cmd+Enter" Command="{Binding SaveCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,18,14,6">
      <StackPanel Spacing="2">
        <TextBlock Classes="h2" Text="{Binding Heading}" />
        <TextBlock Classes="muted" Text="{Binding MetaText}" IsVisible="{Binding !IsNew}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" ToolTip.Tip="Close (Esc)"
              AutomationProperties.Name="Close card panel" VerticalAlignment="Top">
        <PathIcon Data="{StaticResource IconClose}" />
      </Button>
    </Grid>

    <!-- Footer actions -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel Spacing="10">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding !IsNew}">
            <StackPanel.Styles>
              <Style Selector="Button"><Setter Property="Padding" Value="8,6" /></Style>
            </StackPanel.Styles>
            <Button Classes="ghost" Command="{Binding ArchiveCommand}" ToolTip.Tip="Hide the card from the board; restore it any time">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconArchive}" Width="14" Height="14" />
                <TextBlock Text="Archive" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding DuplicateCommand}" ToolTip.Tip="Create a copy below this card">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
                <TextBlock Text="Duplicate" />
              </StackPanel>
            </Button>
            <Button Classes="dangerText" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete card">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
                <TextBlock Text="Delete" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsNew}" />
            <Button Classes="primary" Content="{Binding SaveText}" Command="{Binding SaveCommand}" ToolTip.Tip="Ctrl+Enter" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Fields -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="24,8,24,20">
        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Title" />
          <TextBox Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" infra:FocusBehavior.FocusWhenVisible="True"
                   AutomationProperties.Name="Card title" PlaceholderText="What needs doing?" />
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Spacing="4">
            <TextBlock Classes="fieldLabel" Text="Column" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding SelectedColumn}"
                      AutomationProperties.Name="Column">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="domain:BoardColumn"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Classes="fieldLabel" Text="Priority" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}"
                      AutomationProperties.Name="Priority">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="domain:Priority">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="9" Height="9" Fill="{Binding Converter={x:Static conv:PriorityToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Due date" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <CalendarDatePicker SelectedDate="{Binding DueDate}" Width="200" PlaceholderText="No due date"
                                AutomationProperties.Name="Due date" />
            <Button Classes="ghost" Content="Clear" Command="{Binding ClearDueDateCommand}" IsVisible="{Binding HasDueDate}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Labels" />
          <TextBlock Classes="muted" Text="No labels yet — create one below." IsVisible="{Binding !HasLabelChoices}" />
          <ItemsControl ItemsSource="{Binding LabelChoices}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LabelChoice">
                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,12,0" AutomationProperties.Name="{Binding Label.Name}">
                  <Border Classes="labelChip" Margin="0" Background="{Binding Label.Color, Converter={x:Static conv:HexToBrushConverter.Instance}}">
                    <TextBlock Text="{Binding Label.Name}" />
                  </Border>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <TextBox Text="{Binding NewLabelName}" PlaceholderText="New label name" AutomationProperties.Name="New label name">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddLabelCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="secondary" Margin="6,0,0,0" Content="Add label" Command="{Binding AddLabelCommand}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="fieldLabel" Text="Description" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                   PlaceholderText="Add more detail (plain text)" AutomationProperties.Name="Card description" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
